# Server port number
PORT=5000

# MongoDB connection string (replace with your actual URI)
MONGO_URI=mongodb://localhost:27017/metroTicketingDB

# (Optional) JWT Secret Key for authentication (if you implement JWT later)
JWT_SECRET=your_jwt_secret_key_here

# Payment gateway API keys (example placeholder; replace with your real keys)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Firebase Cloud Messaging API Key for push notifications (if used)
FCM_SERVER_KEY=your_fcm_server_key

# Any other third-party keys/configuration go here
